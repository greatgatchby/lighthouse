# TEMPLATE — this file is committed. Never put real values here.
#
#   cp .env.example .env    and fill in .env (which is gitignored)

# --- Core ---
# Public origin the PWA is served from. Passkeys are bound to this hostname,
# so changing it later invalidates them.
#   local dev:  http://localhost:3000
#   deployed:   https://<machine>.<tailnet>.ts.net
APP_URL=http://localhost:3000
# Host port is 5433: compose maps it there because 5432 is often already taken
# by another project. Inside compose, services reach the DB as postgres:5432.
DATABASE_URL=postgres://lighthouse:lighthouse@127.0.0.1:5433/lighthouse

# 32-byte secret signing session + WebAuthn challenge cookies (openssl rand -hex 32)
SESSION_SECRET=
# 32-byte hex key for AES-256-GCM encryption of provider tokens (openssl rand -hex 32)
# Losing this means re-authorising Monzo. Back it up outside the repo.
TOKEN_ENC_KEY=

# --- Claude ---
ANTHROPIC_API_KEY=

# --- Push (pnpm vapid generates the pair) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Monzo (CONFIDENTIAL client from developers.monzo.com) ---
# A non-confidential client gets no refresh token, so you'd re-auth constantly.
MONZO_CLIENT_ID=
MONZO_CLIENT_SECRET=
# Leave blank to derive ${APP_URL}/api/oauth/monzo/callback automatically.
# Whatever is used must match the redirect registered with Monzo byte-for-byte.
MONZO_REDIRECT_URI=
# 32-byte path secret for the optional Tailscale Funnel webhook (openssl rand -hex 32)
MONZO_WEBHOOK_SECRET=

# --- Lunchflow ---
LUNCHFLOW_API_KEY=

# --- Optional ---
# IANA timezone for schedules and day boundaries
APP_TZ=Europe/London
