# --- Core ---
# Public URL the PWA is served from (your tailnet HTTPS hostname)
APP_URL=https://your-machine.your-tailnet.ts.net
DATABASE_URL=postgres://lighthouse:lighthouse@localhost:5432/lighthouse

# 32+ byte secret for signing session JWTs (openssl rand -hex 32)
SESSION_SECRET=
# 32-byte hex key for AES-256-GCM encryption of provider tokens (openssl rand -hex 32)
TOKEN_ENC_KEY=

# --- Claude ---
ANTHROPIC_API_KEY=

# --- Push (pnpm vapid to generate) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:jngatchu@gmail.com

# --- Monzo (confidential client from developers.monzo.com) ---
MONZO_CLIENT_ID=
MONZO_CLIENT_SECRET=
# Must exactly match the redirect registered with Monzo:
# ${APP_URL}/api/oauth/monzo/callback
MONZO_REDIRECT_URI=
# 32-byte random path secret for the optional Tailscale Funnel webhook (openssl rand -hex 32)
MONZO_WEBHOOK_SECRET=

# --- Lunchflow ---
LUNCHFLOW_API_KEY=

# --- Optional ---
# IANA timezone for schedules and day boundaries
APP_TZ=Europe/London
